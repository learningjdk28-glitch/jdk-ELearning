# Copy to .env. Only the public anon (publishable) key belongs here.
# NEVER put the service_role key in this app: it would ship inside every browser and APK.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Address of the analytics chatbot service (the ChatBot folder). Administrators only. Optional.
# VITE_CHATBOT_URL=http://127.0.0.1:8000

# Public address of the hosted app. Email confirmation and password reset links point here, so they work on other devices.
# Also set it as Site URL and add it to Redirect URLs in Supabase Authentication > URL Configuration.
# VITE_PUBLIC_URL=https://YOUR-APP.YOUR-ACCOUNT.workers.dev
